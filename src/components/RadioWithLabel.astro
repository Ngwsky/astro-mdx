---
import RenderWithCode from "../components/RenderWithCode.astro";
import Radio from "../components/Radio.astro";
---

<RenderWithCode>
  <Radio name="radio-with-label-1" value="1" label="with Label 1" checked />
  <Radio name="radio-with-label-1" value="2" label="with Label 2"  />
  <Radio name="radio-with-label-2" value="1" label="Checked Disabled" checked disabled />
  <Radio name="radio-with-label-2" value="2" label="Disabled" disabled />
</RenderWithCode>
